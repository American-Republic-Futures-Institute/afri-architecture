{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI INC-06 reference overlay manifest",
  "type": "object",
  "required": [
    "id",
    "standard",
    "version",
    "status",
    "snapshot_date",
    "source_catalog",
    "plan_contract",
    "models",
    "constraints",
    "publication_contract"
  ],
  "properties": {
    "id": {
      "const": "ARFI-COA-INST-REF-001"
    },
    "standard": {
      "const": "ARFI-COA"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "research_baseline_unratified"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "source_catalog": {
      "const": "model/federal/manifest.json"
    },
    "plan_contract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "external plan contract",
      "type": "object",
      "required": [
        "repository",
        "commit_sha",
        "authoritative_content_status"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authoritative_content_status": {
          "const": "draft_unratified"
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "pattern": "^model/[a-z-]+/[a-z-]+\\.json$"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "publication_contract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "publication boundaries",
      "type": "object",
      "required": [
        "schema_version",
        "machine_readable",
        "no_web_renderer",
        "public_review_required",
        "authority_edge_status",
        "cross_repo_links"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "machine_readable": {
          "const": true
        },
        "no_web_renderer": {
          "const": true
        },
        "public_review_required": {
          "const": true
        },
        "authority_edge_status": {
          "const": "not_asserted"
        },
        "cross_repo_links": {
          "const": "immutable_plan_commit"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
