          "type": [
            "null",
            "string"
          ],
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        },
        "type": {
          "const": "temporal_source_comparison_candidate"
        }
