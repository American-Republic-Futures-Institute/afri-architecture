{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arfinstitute.org/schemas/article-iii.schema.json",
  "title": "ARFI-COA Article III judicial constitutional architecture v0.1.0",
  "description": "Declarative data shapes; full cross-model identity, source integrity, constitutional scope and safeguard gates reside in scripts/validate-article-iii.mjs.",
  "$defs": {
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "type",
        "section",
        "unit_index",
        "unit_kind",
        "provision_id",
        "name",
        "summary",
        "current_effect_status",
        "norm_ids",
        "qualification_ids",
        "capability_link_ids",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AIII-UNIT-0[1-3]-0[1-3]$"
        },
        "type": {
          "const": "article_iii_unit_analysis"
        },
        "section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "unit_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "unit_kind": {
          "enum": [
            "analytic_segment",
            "numbered_clause"
          ]
        },
        "provision_id": {
          "type": "string",
          "pattern": "^CONST-US-ART-03-"
        },
        "name": {
          "type": "string",
          "minLength": 4
        },
        "summary": {
          "type": "string",
          "minLength": 15
        },
        "current_effect_status": {
          "enum": [
            "operative",
            "modified_in_part"
          ]
        },
        "norm_ids": {
          "$ref": "#/$defs/refs"
        },
        "qualification_ids": {
          "$ref": "#/$defs/refs"
        },
        "capability_link_ids": {
          "$ref": "#/$defs/refs"
        },
        "source_ids": {
          "$ref": "#/$defs/refs"
        },
        "review_status": {
          "const": "textual_summary_pending_legal_review"
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": [
        "id",
        "type",
        "kind",
        "name",
        "summary",
        "origin",
        "source_provision_ids",
        "applies_to_norm_ids",
        "effect_status",
        "legal_review_status",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AIII-QUAL-[A-Z0-9-]+$"
        },
        "type": {
          "const": "article_iii_qualification"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 12
        },
        "origin": {
          "enum": [
            "original_text",
            "amendment_overlay",
            "interpretive_boundary",
            "historical_text"
          ]
        },
        "source_provision_ids": {
          "$ref": "#/$defs/refs"
        },
        "applies_to_norm_ids": {
          "$ref": "#/$defs/refs"
        },
        "effect_status": {
          "enum": [
            "operative",
            "amendment_modified",
            "research_boundary",
            "historical_only"
          ]
        },
        "legal_review_status": {
          "const": "textual_mapping_pending_review"
        },
        "source_ids": {
          "$ref": "#/$defs/refs"
        },
        "article_i_qualification_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AI-QUAL-"
          }
        },
        "article_ii_qualification_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AII-QUAL-"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "alignment": {
      "type": "object",
      "required": [
        "id",
        "type",
        "constitutional_norm_id",
        "capability_id",
        "qualification_ids",
        "relationship_type",
        "rationale",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AIII-CAP-[0-9]{4}$"
        },
        "type": {
          "const": "article_iii_capability_alignment"
        },
        "constitutional_norm_id": {
          "type": "string",
          "pattern": "^NORM-US-CONST-"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^CAP-FED-"
        },
        "qualification_ids": {
          "$ref": "#/$defs/refs"
        },
        "relationship_type": {
          "const": "functional_alignment_not_delegation"
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "source_ids": {
          "$ref": "#/$defs/refs"
        },
        "review_status": {
          "const": "research_mapping_pending_review"
        }
      },
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "matter_group",
        "summary",
        "provision_id",
        "norm_id",
        "qualification_ids",
        "constitutional_effect_status",
        "does_not_self_authorize_inferior_court_jurisdiction",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AIII-JUR-0[1-9]$"
        },
        "type": {
          "const": "article_iii_jurisdiction_category"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "matter_group": {
          "enum": [
            "cases",
            "controversies"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 15
        },
        "provision_id": {
          "const": "CONST-US-ART-03-SEC-02-CL-01"
        },
        "norm_id": {
          "type": "string",
          "pattern": "^NORM-US-CONST-"
        },
        "qualification_ids": {
          "$ref": "#/$defs/refs"
        },
        "constitutional_effect_status": {
          "enum": [
            "operative",
            "modified_in_part"
          ]
        },
        "does_not_self_authorize_inferior_court_jurisdiction": {
          "const": true
        },
        "source_ids": {
          "$ref": "#/$defs/refs"
        },
        "review_status": {
          "const": "research_jurisdiction_mapping_pending_legal_review"
        }
      },
      "additionalProperties": false
    },
    "unitsCollection": {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      },
      "additionalProperties": false
    },
    "qualificationsCollection": {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qualification"
          }
        }
      },
      "additionalProperties": false
    },
    "capabilityLinksCollection": {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/alignment"
          }
        }
      },
      "additionalProperties": false
    },
    "jurisdictionCollection": {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jurisdiction"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/unitsCollection"
    },
    {
      "$ref": "#/$defs/qualificationsCollection"
    },
    {
      "$ref": "#/$defs/capabilityLinksCollection"
    },
    {
      "$ref": "#/$defs/jurisdictionCollection"
    }
  ]
}
