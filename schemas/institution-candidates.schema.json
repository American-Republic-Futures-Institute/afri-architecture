{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI INC-06 nonbinding institutional research links",
  "type": "object",
  "required": [
    "version",
    "status",
    "items"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "research_connections_not_assignments"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "institution candidate",
        "type": "object",
        "required": [
          "id",
          "shared_capability_id",
          "institution_id",
          "relation",
          "current_legal_authority",
          "government_power_assigned",
          "status",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ICAND-[0-9]{4}$"
          },
          "shared_capability_id": {
            "type": "string",
            "pattern": "^CAP-XDOM-[0-9]{3}$"
          },
          "institution_id": {
            "type": "string",
            "pattern": "^ORG-FED-[A-Z0-9-]+$"
          },
          "relation": {
            "const": "potential_study_contributor"
          },
          "current_legal_authority": {
            "const": "not_verified_by_this_model"
          },
          "government_power_assigned": {
            "const": false
          },
          "status": {
            "const": "research_candidate_unratified"
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
