                "const": "element"
              },
              "kind": {
                "type": "string",
                "minLength": 2
              },
              "definition": {
                "type": "string",
                "minLength": 2
              },
              "person_or_population": {
                "type": "boolean"
              },
              "definition_only": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "record_type",
              "kind",
              "definition",
              "member_state",
              "default_federal_subordinate"
            ],
