                "type": "string",
                "minLength": 2
              },
              "record_type": {
                "const": "jurisdiction"
              },
              "kind": {
                "type": "string",
                "minLength": 2
              },
              "definition": {
                "type": "string",
                "minLength": 2
              },
              "member_state": {
                "type": "boolean"
              },
              "default_federal_subordinate": {
                "const": false
              }
            }
          },
          {
            "type": "object",
