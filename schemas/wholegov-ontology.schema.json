              "id",
              "record_type",
              "kind",
              "from_kinds",
              "to_kinds",
              "category",
              "assertion_class",
              "evidence_requirement",
              "definition",
              "directed",
              "transitive_inference",
              "automatic_inverse",
              "legal_power_inferred",
              "operational_action_inferred",
              "public_admission"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
