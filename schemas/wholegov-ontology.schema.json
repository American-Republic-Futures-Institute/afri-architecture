              "category": {
                "enum": [
                  "structure",
                  "rights",
                  "powers",
                  "services",
                  "oversight",
                  "context"
                ]
              },
              "assertion_class": {
                "enum": [
                  "synthetic",
                  "descriptive",
                  "legal",
                  "operational",
                  "analytical"
                ]
              },
              "evidence_requirement": {
                "type": "string",
                "minLength": 2
              },
              "definition": {
                "type": "string",
                "minLength": 2
              },
              "directed": {
                "const": true
              },
              "transitive_inference": {
                "const": false
              },
              "automatic_inverse": {
                "const": false
              },
              "legal_power_inferred": {
                "const": false
              },
              "operational_action_inferred": {
                "const": false
              },
