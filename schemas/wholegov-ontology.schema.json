              "origin_model": {
                "type": "string",
                "minLength": 2
              },
              "origin_predicate": {
                "type": "string",
                "minLength": 2
              },
              "normalized_predicate": {
                "type": "string",
                "minLength": 2
              },
              "source_review_inherited": {
                "const": false
              },
              "automatic_admission": {
                "const": false
              },
              "definition": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "record_type",
              "title",
              "root_kinds",
              "relationship_kinds",
              "max_hops",
              "source_commit_required",
              "admitted_edges_only",
              "public_admission",
              "definition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "record_type": {
                "const": "viewpoint"
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "root_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "relationship_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "max_hops": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "source_commit_required": {
                "const": true
              },
              "admitted_edges_only": {
                "const": true
              },
              "public_admission": {
                "const": false
              },
              "definition": {
                "type": "string",
                "minLength": 2
              }
            }
