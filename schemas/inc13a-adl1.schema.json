{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI INC-13A ADL-1 structural qualification contract",
  "description": "Closed research qualification contract for three selected federal departments; no legal certification or source-independent authority.",
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "va04e_precedent_gate_id",
        "title",
        "required_evidence",
        "review_role",
        "mandatory",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^X13A-GATE-(SCOPE|SOURCE|COHORT|STATUTE|FUNCTIONS|HISTORICAL|HUMAN|CUSTODY|AUDIT)$"
        },
        "va04e_precedent_gate_id": {
          "type": "string",
          "pattern": "^E04E-QUAL-[A-Z]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "string",
          "minLength": 1
        },
        "review_role": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "const": true
        },
        "effect": {
          "const": "prerequisite_only_not_automatic_ADL1_certification"
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "evidence_refs",
        "reviewer_id",
        "reviewed_at",
        "review_decision_id",
        "gap"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^X13A-GATE-[A-Z]+$"
        },
        "status": {
          "enum": [
            "not_met",
            "under_review"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_decision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "gap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "object_id",
        "relation_class",
        "source_observation_id",
        "original_source_record_id",
        "original_relation_id",
        "original_source_relation_type",
        "source_snapshot_id",
        "source_edition_label",
        "source_observed_on",
        "source_ids",
        "effective_from",
        "effective_until",
        "effective_period_status",
        "review_state",
        "legal_effect",
        "independent_legal_decision_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^X13A-REL-[A-Z0-9-]+$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_class": {
          "enum": [
            "source_observed_placement",
            "statutory_composition",
            "administrative_supervision",
            "delegated_authority",
            "operational_command",
            "independent_oversight",
            "adjudicative_jurisdiction",
            "historical_succession"
          ]
        },
        "source_observation_id": {
          "type": "string",
          "pattern": "^X12-OBS-[A-Z0-9-]+$"
        },
        "original_source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "original_relation_id": {
          "type": "string",
          "minLength": 1
        },
        "original_source_relation_type": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_edition_label": {
          "type": "string",
          "minLength": 1
        },
        "source_observed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_period_status": {
          "const": "unverified_not_implied_by_source_snapshot"
        },
        "review_state": {
          "const": "research_only_unreviewed"
        },
        "legal_effect": {
          "const": "none_certified"
        },
        "independent_legal_decision_id": {
          "const": null
        }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_department_id",
        "census_identity_id",
        "source_baseline_commit",
        "scope",
        "as_of_effective_date",
        "complete_first_level_denominator",
        "denominator_qualified",
        "independent_legal_review_complete",
        "adl1_certified",
        "certification_decision_id",
        "review_state",
        "gate_results",
        "research_relationships"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^X13A-PILOT-(DEFENSE|JUSTICE|VA)$"
        },
        "canonical_department_id": {
          "type": "string",
          "pattern": "^ORG-FED-EXE-DEP-(DEFENSE|JUSTICE|VA)$"
        },
        "census_identity_id": {
          "type": "string",
          "pattern": "^X12-IDENTITY-ORG-FED-EXE-DEP-(DEFENSE|JUSTICE|VA)$"
        },
        "source_baseline_commit": {
          "const": "e4252ff4e81d9b4aae52ec930a52588b61ad13ee"
        },
        "scope": {
          "const": "bounded_first_level_structural_qualification_pilot"
        },
        "as_of_effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "complete_first_level_denominator": {
          "const": null
        },
        "denominator_qualified": {
          "const": false
        },
        "independent_legal_review_complete": {
          "const": false
        },
        "adl1_certified": {
          "const": false
        },
        "certification_decision_id": {
          "const": null
        },
        "review_state": {
          "const": "research_only_pending_independent_review"
        },
        "gate_results": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/gate_result"
          }
        },
        "research_relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship_claim"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version",
        "model_family",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "model_family": {
          "const": "inc13a-gates"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version",
        "model_family",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "model_family": {
          "const": "inc13a-pilots"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pilot"
          }
        }
      }
    }
  ]
}
