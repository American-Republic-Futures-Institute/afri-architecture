{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arfinstitute.org/schemas/federal-census.schema.json",
  "title": "ARFI-COA bounded federal institutional census v0.1.0",
  "description": "Exact per-family canonical federal census records. This is research-only and does not confer command, legal power or ADL completeness; dynamic relation semantics additionally validated by federal-census-validation-core.mjs.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taxonomy"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/institution-references"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source-registry"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source-snapshots"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/components"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relationships"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gaps"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/viewpoints"
          }
        }
      }
    }
  ],
  "$defs": {
    "taxonomy": {
      "type": "object",
      "required": [
        "id",
        "type",
        "type_key",
        "label",
        "branch_id",
        "legal_classification_status",
        "boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "federal_institution_class"
        },
        "type_key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "legal_classification_status": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "institution-references": {
      "type": "object",
      "required": [
        "id",
        "type",
        "institution_id",
        "canonical_model_path",
        "canonical_kind",
        "census_class_id",
        "branch_id",
        "parent_catalog_id",
        "source_ids",
        "adl_evidenced",
        "adl_target_min",
        "identity_evidence_status",
        "structural_scope_status",
        "authority_scope_status",
        "official_external_identifier",
        "external_identifier_status",
        "legal_classification_status",
        "evidence_snapshot",
        "last_verified_at",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "federal_canonical_institution_reference"
        },
        "institution_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "canonical_model_path": {
          "type": "string"
        },
        "canonical_kind": {
          "type": "string"
        },
        "census_class_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "parent_catalog_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "adl_evidenced": {
          "const": 0
        },
        "adl_target_min": {
          "type": "integer"
        },
        "identity_evidence_status": {
          "type": "string"
        },
        "structural_scope_status": {
          "type": "string"
        },
        "authority_scope_status": {
          "type": "string"
        },
        "official_external_identifier": {
          "const": null
        },
        "external_identifier_status": {
          "type": "string"
        },
        "legal_classification_status": {
          "type": "string"
        },
        "evidence_snapshot": {
          "type": "string"
        },
        "last_verified_at": {
          "const": null
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source-registry": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "publisher",
        "url",
        "published_on",
        "accessed_on",
        "evidence_kind",
        "revision_basis",
        "scope_boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "census_primary_source"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_on": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string"
        },
        "revision_basis": {
          "type": "string"
        },
        "scope_boundary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source-snapshots": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source_id",
        "edition_date",
        "retrieved_on",
        "revision_id",
        "scope",
        "denominator_status",
        "immutable_url",
        "snapshot_kind",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "federal_source_snapshot"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "edition_date": {
          "type": "string"
        },
        "retrieved_on": {
          "type": "string"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "scope": {
          "type": "string"
        },
        "denominator_status": {
          "type": "string"
        },
        "immutable_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_kind": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "required": [
        "id",
        "type",
        "parent_institution_id",
        "branch_id",
        "name",
        "kind",
        "model_class_id",
        "source_ids",
        "evidence_locator",
        "organizational_relation",
        "adl_evidenced",
        "identity_status",
        "legal_authority_status",
        "delegation_verified",
        "appropriation_verified",
        "review_status",
        "snapshot_id",
        "scope_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "first_level_component_candidate"
        },
        "parent_institution_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "model_class_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_locator": {
          "type": "string"
        },
        "organizational_relation": {
          "type": "string"
        },
        "adl_evidenced": {
          "const": 0
        },
        "identity_status": {
          "type": "string"
        },
        "legal_authority_status": {
          "type": "string"
        },
        "delegation_verified": {
          "const": false
        },
        "appropriation_verified": {
          "const": false
        },
        "review_status": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "scope_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "object",
      "required": [
        "id",
        "type",
        "from_id",
        "to_id",
        "relationship_type",
        "classification",
        "source_ids",
        "snapshot_id",
        "operational_command_proven",
        "delegated_statutory_power_proven",
        "classification_review_complete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "federal_evidenced_organization_relation"
        },
        "from_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "to_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "relationship_type": {
          "enum": [
            "statutory_composition_only",
            "agency_directory_or_chart_membership",
            "independent_oversight_placement_not_command"
          ]
        },
        "classification": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "operational_command_proven": {
          "const": false
        },
        "delegated_statutory_power_proven": {
          "const": false
        },
        "classification_review_complete": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "gaps": {
      "type": "object",
      "required": [
        "id",
        "type",
        "parent_institution_id",
        "dimension",
        "gap_kind",
        "priority",
        "next_research",
        "closure_condition",
        "denominator",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "federal_coverage_gap"
        },
        "parent_institution_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "dimension": {
          "type": "string"
        },
        "gap_kind": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "next_research": {
          "type": "string"
        },
        "closure_condition": {
          "type": "string"
        },
        "denominator": {
          "const": "unknown"
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "viewpoints": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "root_ids",
        "source_model_paths",
        "allowed_relation_types",
        "render_status",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "type": {
          "const": "census_institution_reference_view"
        },
        "title": {
          "type": "string"
        },
        "root_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_model_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_relation_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "render_status": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
