{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI COA source register",
  "type": "object",
  "required": [
    "model_version",
    "items"
  ],
  "properties": {
    "model_version": {
      "const": "0.1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "kind",
          "scope",
          "accessed_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
