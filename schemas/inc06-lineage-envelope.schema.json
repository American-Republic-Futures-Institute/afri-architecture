{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI INC-06 Federal Budget Lineage common envelope",
  "type": "object",
  "required": [
    "model_version",
    "model_family",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "model_version": {
      "const": "0.1.0"
    },
    "model_family": {
      "type": "string",
      "pattern": "^inc06-(sources|enactments|accounts|actors|programs|controls|metrics|outcomes|gaps|relationships|traces)$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:X06|SRC-X06)-[A-Z0-9-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9-]+$"
            }
          },
          "review_status": {
            "type": "string"
          },
          "verified": {
            "const": false
          },
          "individual_transaction_evidenced": {
            "const": false
          },
          "actual_sf132_verified": {
            "const": false
          },
          "human_qualified_legal_review_complete": {
            "const": false
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "federal_primary_evidence_reference"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ]
            },
            "else": {
              "required": [
                "source_ids"
              ]
            }
          }
        ]
      }
    }
  }
}
