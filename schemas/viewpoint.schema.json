{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI COA viewpoint",
  "type": "object",
  "required": [
    "model_version",
    "items"
  ],
  "properties": {
    "model_version": {
      "const": "0.1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "purpose",
          "root_ids",
          "max_hierarchy_depth",
          "included_relationship_types",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VIEW-FED-"
          },
          "type": {
            "const": "viewpoint"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "root_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "max_hierarchy_depth": {
            "type": "integer",
            "minimum": 1
          },
          "included_relationship_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "descriptive_candidate"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
