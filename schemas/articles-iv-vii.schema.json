        "norm_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "link_semantics": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "viewpoints": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "root_provision_id",
        "unit_ids",
        "renderer_owner",
        "publication_status",
        "review_status",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8
