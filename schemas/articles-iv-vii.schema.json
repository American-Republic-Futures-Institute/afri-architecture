        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8
        },
        "type": {
          "const": "article_iv_vii_comprehensive_unit"
        },
        "article": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "unit_kind": {
          "type": "string",
          "minLength": 1
        },
        "provision_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "current_effect_status": {
          "type": "string",
          "minLength": 1
        },
        "norm_ids": {
          "type": "array",
