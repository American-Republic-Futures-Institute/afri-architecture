{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arfinstitute.org/schemas/articles-iv-vii.schema.json",
  "title": "ARFI-COA Articles IV–VII Original-Text Model",
  "description": "Five strict, separate original-text analytical model family shapes. Semantic legal boundaries validated by scripts/validate-article-iv-vii.mjs.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/units"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifications"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor-links"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability-links"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "model_version",
        "items"
      ],
      "properties": {
        "model_version": {
          "const": "0.1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewpoints"
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "units": {
      "type": "object",
      "required": [
        "id",
        "type",
        "article",
        "ordinal",
        "unit_kind",
        "provision_id",
        "name",
        "summary",
        "current_effect_status",
