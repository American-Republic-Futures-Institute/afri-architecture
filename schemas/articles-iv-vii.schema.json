        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capability-links": {
      "type": "object",
      "required": [
        "id",
        "type",
        "unit_id",
        "norm_id",
        "capability_id",
        "qualification_ids",
        "link_semantics",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8
        },
        "type": {
          "const": "article_iv_vii_functional_capability_link"
