          "items": {
            "type": "string"
          }
        },
        "qualification_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "actor_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "capability_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "existing_federalism_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "existing_federalism_qualification_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "existing_federalism_actor_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "existing_federalism_capability_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
