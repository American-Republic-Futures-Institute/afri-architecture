        "type",
        "unit_id",
        "qualification_kind",
        "summary",
        "source_provision_ids",
        "current_effect_status",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8
        },
        "type": {
          "const": "article_iv_vii_textual_qualification"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification_kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_provision_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "current_effect_status": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "actor-links": {
      "type": "object",
