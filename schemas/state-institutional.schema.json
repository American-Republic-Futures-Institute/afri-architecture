{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arfinstitute.org/schemas/state-institutional.schema.json",
  "title": "ARFI-COA State Institutional and Federalism Extension v0.1.0",
  "description": "Portable data collection schemas for 50 State IDs, source-linked VA and Nebraska pilot institutional architecture, cross-federal legal boundaries and a segregated D.C. federal-district comparator. Semantic validation lives in scripts/validate-state.mjs.",
  "oneOf": [
    {
      "$ref": "#/$defs/jurisdictionsCollection"
    },
    {
      "$ref": "#/$defs/nonstate-comparatorsCollection"
    },
    {
      "$ref": "#/$defs/sourcesCollection"
    },
    {
      "$ref": "#/$defs/constitutionsCollection"
    },
    {
      "$ref": "#/$defs/provisionsCollection"
    },
    {
      "$ref": "#/$defs/normsCollection"
    },
    {
      "$ref": "#/$defs/actorsCollection"
    },
    {
      "$ref": "#/$defs/branchesCollection"
    },
    {
      "$ref": "#/$defs/institutionsCollection"
    },
    {
      "$ref": "#/$defs/relationshipsCollection"
    },
    {
      "$ref": "#/$defs/federalism-linksCollection"
    },
    {
      "$ref": "#/$defs/judicial-linksCollection"
    },
    {
      "$ref": "#/$defs/viewpointsCollection"
    }
  ],
  "$defs": {
    "jurisdictions": {
      "type": "object",
      "title": "ARFI State jurisdictions item",
      "required": [
        "id",
        "type",
        "name",
        "usps_code",
        "fips_state_code",
        "sovereign_classification",
        "state_constitution_id",
        "institutional_coverage",
        "external_nonstate_comparator_ids",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^JUR-US-[A-Z]{2}$"
        },
        "type": {
          "type": "string",
          "const": "us_member_state_jurisdiction"
        },
        "name": {
          "type": "string"
        },
        "usps_code": {
          "type": "string"
        },
        "fips_state_code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "sovereign_classification": {
          "type": "string"
        },
        "state_constitution_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "institutional_coverage": {
          "type": "string"
        },
        "external_nonstate_comparator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-STATE-"
          }
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nonstate-comparators": {
      "type": "object",
      "title": "ARFI State nonstate-comparators item",
