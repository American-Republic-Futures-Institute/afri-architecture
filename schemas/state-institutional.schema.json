        "id",
        "type",
        "name",
        "usps_code",
        "fips_state_code",
        "is_member_state",
        "constitutional_status",
        "institutional_coverage",
        "source_ids",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^JUR-US-DC-NONSTATE$"
        },
        "type": {
          "type": "string",
          "const": "nonstate_federal_district_reference"
        },
        "name": {
          "type": "string"
        },
        "usps_code": {
          "type": "string"
        },
        "fips_state_code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "is_member_state": {
          "type": "boolean"
        },
        "constitutional_status": {
          "type": "string"
        },
        "institutional_coverage": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-STATE-"
          }
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
