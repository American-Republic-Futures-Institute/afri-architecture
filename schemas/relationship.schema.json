{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI COA relationships",
  "type": "object",
  "required": [
    "model_version",
    "items"
  ],
  "properties": {
    "model_version": {
      "const": "0.1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_id",
          "to_id",
          "relationship_type",
          "status",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REL-FED-[0-9]{4}$"
          },
          "from_id": {
            "type": "string"
          },
          "to_id": {
            "type": "string"
          },
          "relationship_type": {
            "enum": [
              "performs_capability",
              "established_under",
              "exercises_power_under",
              "exercises_oversight_of",
              "executes_laws_enacted_by",
              "advises_or_supports",
              "reviews_decisions_of",
              "sets_administrative_policy_for"
            ]
          },
          "status": {
            "const": "observed_summary"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
