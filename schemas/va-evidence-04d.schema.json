        "body_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "capture_run_id": {
          "type": "integer",
          "minimum": 0
        },
        "durable_write_once_approved": {
          "const": false
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "independent_sha256_comparison": {
          "type": "string",
          "minLength": 1
        },
        "institutionally_signed": {
          "const": false
        },
        "legal_review_completed": {
