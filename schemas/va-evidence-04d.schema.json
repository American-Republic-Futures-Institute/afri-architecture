        "legal_review_approved": {
          "const": false
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organizational_reporting_verified": {
          "const": false
        },
        "source_sha256": {
          "const": null
        },
        "statutory_status_current": {
          "const": false
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporal-events": {
      "type": "object",
      "additionalProperties": false,
