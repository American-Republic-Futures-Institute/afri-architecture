        "distinct_custodian_approval": {
          "const": null
        },
        "fully_attested": {
          "const": false
        },
        "hash_alg": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "immutable_storage_proof": {
          "const": null
        },
        "independent_legal_approval": {
          "const": null
        },
        "protected_archive_location": {
          "const": null
        },
        "ratified_retention_years": {
          "const": null
        },
        "release_state": {
          "type": "string",
          "minLength": 1
        },
        "retention_policy_id": {
          "const": null
        },
        "signer_fingerprint_sha256": {
          "const": null
