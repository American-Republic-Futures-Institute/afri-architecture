        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "statute_38_301_c7_repealed_inferred": {
          "const": false
        },
        "to_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust-gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_signer",
