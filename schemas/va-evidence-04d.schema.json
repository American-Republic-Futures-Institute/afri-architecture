        "label",
        "matched_directory_candidate",
        "predecessor_id",
        "regulatory_delegation_verified",
        "source_edition_bytes_verified",
        "source_id",
        "type"
      ],
      "properties": {
        "absence_means_abolished": {
          "const": false
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "current_legal_status_verified": {
          "const": false
        },
        "human_approved": {
          "const": false
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "matched_directory_candidate": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 1
        },
        "predecessor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "regulatory_delegation_verified": {
          "const": false
        },
        "source_edition_bytes_verified": {
          "const": false
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legal-identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicative_jurisdiction_verified",
        "basis",
        "department",
        "id",
        "legal_review_approved",
        "name",
        "organizational_reporting_verified",
        "source_sha256",
        "statutory_status_current",
        "type"
      ],
      "properties": {
        "adjudicative_jurisdiction_verified": {
          "const": false
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
