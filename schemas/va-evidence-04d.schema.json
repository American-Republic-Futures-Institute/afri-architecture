  "$defs": {
    "source-targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_capture_verified",
        "captured_at",
        "description",
        "edition",
        "id",
        "immutable_promotion_verified",
        "independently_reviewed",
        "mime",
        "observed_bytes",
        "observed_sha256",
        "type",
        "url"
      ],
      "properties": {
        "byte_capture_verified": {
          "const": false
        },
        "captured_at": {
          "const": null
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "immutable_promotion_verified": {
          "const": false
        },
        "independently_reviewed": {
          "const": false
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "observed_bytes": {
          "const": null
        },
        "observed_sha256": {
          "const": null
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        }
      }
    },
    "statutory-crosswalk": {
      "type": "object",
