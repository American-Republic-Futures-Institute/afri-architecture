{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arfinstitute.org/schemas/va-evidence-04d-v0.1.0.schema.json",
  "title": "ARFI VA Inc04D original source receipts and source-bounded institutional research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "model_family",
    "items"
  ],
  "properties": {
    "model_version": {
      "const": "0.1.0"
    },
    "model_family": {
      "type": "string",
      "enum": [
        "source-targets",
        "statutory-crosswalk",
        "legal-identities",
        "temporal-events",
        "trust-gates",
        "review-approvals",
        "coverage",
        "observed-source-receipts",
        "fom-page-anchors"
      ]
    },
    "items": {
      "type": "array"
    }
  },
  "oneOf": [
    {
      "properties": {
        "model_family": {
          "const": "source-targets"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source-targets"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "statutory-crosswalk"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statutory-crosswalk"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "legal-identities"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legal-identities"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "temporal-events"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporal-events"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "trust-gates"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trust-gates"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "review-approvals"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review-approvals"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "coverage"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "observed-source-receipts"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observed-source-receipts"
          }
        }
      }
    },
    {
      "properties": {
        "model_family": {
          "const": "fom-page-anchors"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fom-page-anchors"
          }
        }
      }
    }
