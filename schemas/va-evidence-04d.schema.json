        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]{2,170}$"
        },
        "publisher_effective_date": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "const": null
