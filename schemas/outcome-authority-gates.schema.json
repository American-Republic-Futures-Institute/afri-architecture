{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "INC-07 unresolved legal research gates",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "authority gate",
        "required": [
          "id",
          "name",
          "gate_kind",
          "research_question",
          "evidence_ids",
          "legal_status",
          "satisfied",
          "authorizes_action",
          "reviewer_role",
          "release_gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AGATE-07-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 4
          },
          "gate_kind": {
            "type": "string",
            "minLength": 4
          },
          "research_question": {
            "type": "string",
            "minLength": 30
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EVID-07-[0-9]{2}$"
            }
          },
          "legal_status": {
            "const": "not_verified_for_any_option"
          },
          "satisfied": {
            "const": false
          },
          "authorizes_action": {
            "const": false
          },
          "reviewer_role": {
            "const": "qualified_constitutional_statutory_and_jurisdictional_review"
          },
          "release_gate": {
            "const": "no_implementation_until_independently_verified"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
